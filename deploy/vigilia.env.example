# /etc/vigilia/vigilia.env  (droits 600, proprietaire root)
# Compte SSH utilise pour interroger les switches. Idealement un compte en LECTURE SEULE.
SW_USER=vigiliaro
# Switches a superviser : adresses separees par des virgules, plages a.b.c.X-Y acceptees.
# (192.0.2.0/24 est une plage reservee a la documentation : remplacez par vos adresses)
SW_HOSTS=192.0.2.10,192.0.2.11-14
PYTHONDONTWRITEBYTECODE=1
# Le mot de passe du compte SSH ne se met PAS ici : voir /etc/vigilia/sw_pass (LoadCredential).
